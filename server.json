{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.peturgeorgievv-factory/postfast-mcp",
  "title": "PostFast",
  "description": "Schedule posts on 11 social networks, answer comments and read analytics, hosted or local",
  "websiteUrl": "https://postfa.st/api-integrations/mcp",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/peturgeorgievv-factory/postfast-mcp/main/assets/logo.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    }
  ],
  "repository": {
    "url": "https://github.com/peturgeorgievv-factory/postfast-mcp",
    "source": "github"
  },
  "version": "0.15.2",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "postfast-mcp",
      "version": "0.15.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Your PostFast workspace API key. Get it from https://app.postfa.st/dashboard → API in the sidebar.",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "POSTFAST_API_KEY"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.postfa.st/mcp"
    }
  ]
}